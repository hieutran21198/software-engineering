{
  "permissions": {
    "allow": [
      "Shell(grep:*)",
      "Shell(sed:*)"
    ],
    "deny": [],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "artifact-plane hook || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "artifact-plane hook || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "artifact-plane hook || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "artifact-plane hook || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
