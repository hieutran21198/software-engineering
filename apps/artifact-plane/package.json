{
  "name": "artifact-plane",
  "version": "1.17.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "vite build",
    "test": "state=$(mktemp -d) && ARTIFACT_PLANE_STATE_DIR=$state node --test test/*.test.js; status=$?; rm -rf \"$state\"; exit $status",
    "test:browser": "playwright test",
    "flow:model-install": "node scripts/install-flow-model.mjs",
    "mcp": "node server/flow-mcp-stdio.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fontsource/source-serif-4": "5.2.9",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xyflow/react": "^12.12.0",
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.2",
    "dompurify": "^3.4.17",
    "highlight.js": "11.12.0",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    },
    "onnxruntime-node": {
      "global-agent": "4.1.3"
    }
  }
